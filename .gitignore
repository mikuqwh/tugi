# Android/Flutter build artifacts
build/
*.apk
*.aab
# Local release artifacts (built by hand, not tracked)
dist/
# Generated by the Flutter tool
.flutter-plugins
.flutter-plugins-dependencies
.flutter_tool_state
android/local.properties
*.iml
# Python
__pycache__/
*.pyc
# Test outputs
test/output/
*.gif
!assets/**/*.gif
*.png
!assets/**/*.png
# Launcher icons and other packaged Android/iOS resources are part of the app,
# not throwaway output: the blanket *.png rule used to strip them from the repo,
# which made a fresh clone fail to build (missing mipmap/ic_launcher_foreground).
!android/app/src/main/res/**/*.png
!android/app/src/main/res/**/*.webp
!ios/Runner/Assets.xcassets/**/*.png
!web/icons/**/*.png
*.mp4
*.avi
# IDE
.vscode/
.idea/
# OS
.DS_Store
Thumbs.db
# Logs
*.log
# Environment
.env
# Signing — NEVER commit these
android/key.properties
*.jks
*.keystore
# Dart/Flutter
.dart_tool/
flutter_test.log
# Large assets (44MB model)
assets/flutter_assets/models/*.pth
assets/flutter_assets/models/*.onnx

# Probe fixtures (regenerated by the scripts)
tool/wmprobe/mw/
tool/wmprobe/wmfont.ttf

# Generated matrix artifacts
tool/formats/.out/

# Dart package build state
packages/*/.dart_tool/
packages/*/build/

# Probe scratch dirs
tool/formats/apng/
tool/formats/itv/

# Flutter tool scratch
.flutter_tool_state
